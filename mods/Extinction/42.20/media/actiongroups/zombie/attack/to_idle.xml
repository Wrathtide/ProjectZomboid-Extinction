<?xml version="1.0" encoding="utf-8"?>
<transitions>
    <transition>
        <transitionTo>idle</transitionTo>
        <conditions>
            <isTrue>ZombieBiteDone</isTrue>
            <isFalse>bEatBodyTarget</isFalse>
            <isFalse>ExtinctionAnimalBiteActive</isFalse>
        </conditions>
    </transition>
    <transition>
        <transitionTo>idle</transitionTo>
        <conditions>
            <isFalse>bCanSeeTarget</isFalse>
            <isFalse>ExtinctionAnimalBiteActive</isFalse>
        </conditions>
    </transition>
    <!-- An unset custom variable is not equivalent to boolean false in the
         native action evaluator. Preserve exits for ordinary zombie attacks. -->
    <transition>
        <transitionTo>idle</transitionTo>
        <conditions>
            <isTrue>ZombieBiteDone</isTrue>
            <isFalse>bEatBodyTarget</isFalse>
            <equals a="ExtinctionAnimalBiteActive" b=""/>
        </conditions>
    </transition>
    <transition>
        <transitionTo>idle</transitionTo>
        <conditions>
            <isFalse>bCanSeeTarget</isFalse>
            <equals a="ExtinctionAnimalBiteActive" b=""/>
        </conditions>
    </transition>
</transitions>
